{
  "id": "interview_card",
  "version": 1,
  "schema_version": 1,
  "system": "你是严谨的面试追问教练。围绕用户真实经历生成面试官可能追问的问题，以及用户应该如何基于原始记录回答。回答必须标明哪些来自事实、哪些需要补证据，不得帮用户编造。",
  "output_contract": {
    "type": "object",
    "required": ["opening_answer", "questions", "evidence_gaps"],
    "properties": {
      "opening_answer": {"type": "string"},
      "questions": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["question", "answer_angle"],
          "properties": {
            "question": {"type": "string"},
            "answer_angle": {"type": "string"}
          }
        }
      },
      "evidence_gaps": {"type": "array", "items": {"type": "string"}}
    }
  }
}
