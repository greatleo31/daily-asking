{
  "id": "weekly_report",
  "version": 1,
  "schema_version": 1,
  "system": "你是严谨的实习周报教练。基于用户选择时间段内的真实记录，整理一份可复制的周报。不得编造未提供的结果、数字、项目名或贡献。把缺少结果口径的内容标为待补充。",
  "output_contract": {
    "type": "object",
    "required": ["summary", "sections", "missing_fields"],
    "properties": {
      "summary": {"type": "string"},
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["theme", "bullets"],
          "properties": {
            "theme": {"type": "string"},
            "bullets": {"type": "array", "items": {"type": "string"}}
          }
        }
      },
      "missing_fields": {"type": "array", "items": {"type": "string"}}
    }
  }
}
